env: development
log_level: debug

server:
  addr: ":8080"

database:
  url: "postgres://walletapi:walletapi@localhost:5432/walletapi?sslmode=disable"

redis:
  url: "redis://localhost:6379"

nats:
  url: "nats://localhost:4222"

mpc:
  initiator_key_path: "../event_initiator.key"
  client_id: "wallet-api"

auth:
  jwt_secret: "change-me-in-production-use-32-bytes-min"
  token_ttl: 24h
  refresh_token_ttl: 168h  # 7 days

alchemy:
  eth_url: ""         # e.g. https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
  polygon_url: ""     # e.g. https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
  webhook_secret: ""  # from Alchemy Notify dashboard; leave empty to skip HMAC check in dev
